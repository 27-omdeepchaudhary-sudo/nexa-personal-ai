# NEXA configuration examples
# Copy these settings into your local .env file if needed.
# Do not put real API keys in this example file.

# Ollama local server
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3:8b

# Optional OpenAI mode (disabled by default)
NEXA_USE_OPENAI=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
